{
    "name": "Ubuntu 24.04 with VNC",
    "image": "tdcode/asd-turtlebot4-docker:gpu", 
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
    "workspaceFolder": "/workspace",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/bin/bash"
            }
        }
    },
    "containerEnv": {
        "DISPLAY": "${localEnv:DISPLAY}"
    },   
    "appPort": [
        "6080:80"
    ],
    "remoteUser": "ubuntu",
    "overrideCommand": false,
    "privileged": true,
    "runArgs": [
        "--hostname=ros2-vnc-docker",
        "--shm-size=512m",
        "--init",
        "--network",
        "host",     
        "-v",
        "./docker/bash:/home/ubuntu/bash",
        "--security-opt",
        "seccomp=unconfined",
        "-v",
        "/etc/turtlebot4:/etc/turtlebot4",
        "-v",
        "${localEnv:HOME}${localEnv:USERPROFILE}/data:/workspace/data",
        "--runtime=nvidia",                         
        "--gpus",                                   
        "all",                                      
        "--volume",                                 
        "/usr/local/cuda-12.8:/usr/local/cuda-12.8"          
    ],
    "postCreateCommand": "cat .devcontainer/bashrc >> ~/.bashrc"
}
