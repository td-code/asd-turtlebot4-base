# additions to ~/.bashrc

# >>> persistent bash history >>>
export HISTFILE=~/bash/.bash_history
touch "$HISTFILE"   # ~/bash is always mounted into the container

# >>> ROS 2 Setup >>>
# Adjust the ROS_DISTRO variable to match your installed ROS 2 distro
# Supported: humble, iron, jazzy (Ubuntu 24.04 likely uses jazzy or iron)
export ROS_DISTRO=jazzy  # change to 'iron' or 'humble' if needed

# Source ROS 2
source /opt/ros/$ROS_DISTRO/setup.bash

# PC-specific identity (must be mounted into the container).
# /etc/turtlebot4/setup.bash only contains: export PC_STANDALONE_DOMAIN_ID=101..106
if [ -f /etc/turtlebot4/setup.bash ]; then
    source /etc/turtlebot4/setup.bash
fi

# Default for every new terminal: local mode (simulation), no discovery server.
# Does NOT touch the ros2 daemon. Robot mode: source enable_turtlebot.sh <1..5>
# ROS_SUPER_CLIENT must never be set in the shell (Nav2 fails to start).
export RMW_IMPLEMENTATION=rmw_fastrtps_cpp
if [ -n "$PC_STANDALONE_DOMAIN_ID" ]; then
    export ROS_DOMAIN_ID="$PC_STANDALONE_DOMAIN_ID"
else
    echo "WARNING: PC_STANDALONE_DOMAIN_ID not set (/etc/turtlebot4/setup.bash not mounted?)" >&2
fi
export ROS_AUTOMATIC_DISCOVERY_RANGE=LOCALHOST
# Gazebo transport on loopback only (fixes Fuel asset download in simulation)
export GZ_IP=127.0.0.1
unset ROS_DISCOVERY_SERVER ROS_STATIC_PEERS ROS_LOCALHOST_ONLY ROS_SUPER_CLIENT

# activate venv
source /opt/ros_venv/bin/activate
export PYTHONPATH=/opt/ros_venv/lib/python3.12/site-packages

# Colcon workspace setup (optional)
if [ -f /workspace/install/setup.bash ]; then
    source /workspace/install/setup.bash
fi

# Prompt prefix: [BOT:<id>] (red, discovery server active) or [LOCAL:<id>] (green)
# Mode is derived from the environment, so it always reflects the current shell.
# ROS_PROMPT_PREFIX is intentionally not exported.
set_ros_prompt() {
    # 1. Remember the original PS1 once; always rebuild from it (never strip),
    #    so the prefix cannot stack up, whatever else touches PS1.
    [ -z "${ROS_BASE_PS1+x}" ] && ROS_BASE_PS1="$PS1"

    # 2. Build the new prefix
    local tag color
    if [ -n "$ROS_DISCOVERY_SERVER" ]; then
        tag="BOT";   color='1;31'
    else
        tag="LOCAL"; color='1;32'
    fi
    PS1="\[\e[${color}m\][${tag}:${ROS_DOMAIN_ID:-?}]\[\e[0m\] ${ROS_BASE_PS1}"
}

# Forget a PS1 captured by an earlier source of this file; not exported on purpose
unset ROS_BASE_PS1 ROS_PROMPT_PREFIX
# Overwrites any previous PROMPT_COMMAND (intended)
PROMPT_COMMAND=set_ros_prompt
